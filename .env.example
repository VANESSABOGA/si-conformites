APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ------------------------------------------------------------------
# SI-RH — Notifications (voir config/sirh.php)
# ------------------------------------------------------------------
# Port 465 = SSL implicite
# MAIL_PORT=465
# MAIL_ENCRYPTION=tls

# Boîtes destinataires (plusieurs adresses séparées par des virgules)
SIRH_EMAILS_RH=vanessa.boga@yakoafricassur.com
SIRH_EMAIL_CONTACT_RH=
SIRH_EMAILS_BIENVENUE_CC=
SIRH_EMAILS_BIENVENUE_BCC=

# Rôles Spatie destinataires des workflows
SIRH_ROLES_RH=rh,admin

# false = notifications applicatives uniquement (aucun email)
SIRH_NOTIFICATIONS_MAIL=true

# DEV/RECETTE : redirige TOUS les emails vers cette adresse (ignoré en production)
MAIL_REDIRECT_TO=

# Recommandé : envoi des emails en arrière-plan (php artisan migrate + cron schedule:run)
# QUEUE_CONNECTION=database

# Application Conformité externalisée (conflits d'intérêts)
CONFORMITE_URL=https://conformite.yakoafricassur.com
